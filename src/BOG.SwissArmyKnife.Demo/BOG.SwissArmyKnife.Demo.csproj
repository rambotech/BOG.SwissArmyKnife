<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks> 
		<Version>1.18.1.0</Version>
    <AssemblyVersion>1.18.1.0</AssemblyVersion>
    <FileVersion>1.18.1</FileVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ApplicationIcon>multitool.ico</ApplicationIcon>
    <PackageIcon>multitool.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="multitool.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\multitool.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BOG.SwissArmyKnife\BOG.SwissArmyKnife.csproj" />
  </ItemGroup>

</Project>
